{
  "name": "candid-duo-editor",
  "private": true,
  "version": "1.0.0",
  "description": "Build source for the CMS visual (rich text) story editor. Output is committed to ../lib/editor.bundle.js \u2014 the deployed site never runs this.",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.js --bundle --format=esm --minify --target=es2020 --outfile=../lib/editor.bundle.js && node licenses.mjs",
    "test": "node test/roundtrip.test.mjs"
  },
  "dependencies": {
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-placeholder": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "tiptap-markdown": "0.9.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "30.1.1",
    "markdown-it": "15.0.2"
  }
}
